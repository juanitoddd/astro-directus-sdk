---
import "@/styles/global.css";
import { getLangFromUrl } from '@/lib/i18n';
import { Font } from "astro:assets";
import Menu from "@/components/layout/Menu.astro";
import MenuMobile from "@/components/layout/MenuMobile.astro";
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import Footer from "@/components/layout/Footer.astro";

type Props = { title?: string; menuName?: string; footerName?: string };
const { title = "Gustav Mahler Jugendorchester", menuName = "main", footerName = "footer" } = Astro.props as Props;
const currentLang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">		
		<link
			rel="stylesheet"
			type="text/css"
			href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css"
			/>
			<link
			rel="stylesheet"
			type="text/css"
			href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css"
			/>
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-GTEestiProText" preload />
		<!--
			<Font cssVariable="--font-roboto" preload />
			<Font cssVariable="--font-montserrat" preload />
			<Font cssVariable="--font-playfair-display" preload />		
		-->
		<title>{title}</title>

		<link rel="icon" href="https://cms.gmjo.at/assets/c98eb5b4-410f-4638-8195-2da450c7d0cd.png?v=2" sizes="32x32" />
		<link rel="icon" href="https://cms.gmjo.at/assets/35c3ef0a-7eeb-4ca4-8845-ab9f67246339.png?v=2" sizes="192x192" />
		<link rel="apple-touch-icon" href="https://cms.gmjo.at/assets/a7b28496-c488-411f-a00c-442e7c0ab7f2.png?v=2" />
		
		
		<script>
		const VISUAL_EDITING_PARAM = 'visual-editing';
		const isVisualEditing = new URLSearchParams(location.search).get(VISUAL_EDITING_PARAM) === 'true';

		const initDirectusVisualEditor = async () => {
			if (!isVisualEditing) return;
			const directusUrl = 'https://cms.gmjo.at';
			try {
				const { apply } = await import('@directus/visual-editing');
				await apply({ directusUrl });
			} catch (e) {
				console.error('Directus visual editor init failed:', e);
			}
		};

		const propagateVisualEditingParam = () => {
			if (!isVisualEditing) return;
			document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
				const href = a.getAttribute('href');
				if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
				try {
					const url = new URL(href, location.href);
					if (url.origin !== location.origin) return;
					if (url.searchParams.get(VISUAL_EDITING_PARAM) === 'true') return;
					url.searchParams.set(VISUAL_EDITING_PARAM, 'true');
					a.setAttribute('href', url.pathname + url.search + url.hash);
				} catch {
					/* ignore unparseable href */
				}
			});
		};

		const onReady = () => {
			propagateVisualEditingParam();
			initDirectusVisualEditor();
		};

		document.readyState === 'loading'
			? document.addEventListener('DOMContentLoaded', onReady)
			: onReady();
	</script>
	</head>
	<body class="overflow-x-hidden">
		<header class="sticky top-0 z-10">
			<div class="hidden md:grid bg-white grid-cols-3 items-center px-6 py-4">
				<Menu name={menuName} lang={currentLang} />
				<a href="/" class="text-2xl font-bold text-center uppercase font-light">Gustav Mahler <br/> JUGENDORCHESTER</a>
				<LanguageSwitcher />
			</div>
			<div class="grid md:hidden grid-cols-3 bg-white items-center px-6 py-4 bg-gmjo-blue text-white">
				<MenuMobile name={menuName} lang={currentLang} />
				<a href="/" class="text-lg font-bold text-center text-black uppercase font-light">GMJO</a>
				<LanguageSwitcher />
			</div>
		</header>		
		<main>
			<slot />
		</main>
		<Footer name={footerName} lang={currentLang} />
	</body>	
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
