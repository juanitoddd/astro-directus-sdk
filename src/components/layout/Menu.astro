---
import { fetchMenuBySlug } from "@/lib/directus/menu";
import { pickTranslation } from "@/lib/directus/types";

type Props = {
  slug: string;
  lang: string;
  class?: string;
};

const { slug, lang, class: className } = Astro.props as Props;
const menu = await fetchMenuBySlug(slug);
const items = menu?.items ?? [];

function resolveMenuUrl(url: string | null | undefined, lang: string): string {
  if (!url) return "#";
  // External, protocol-prefixed, or hash-only URLs: leave untouched
  if (/^([a-z][a-z0-9+.-]*:|\/\/|#)/i.test(url)) return url;
  // Absolute path
  if (url.startsWith("/")) {
    if (url === "/") return `/${lang}`;
    if (url === `/${lang}` || url.startsWith(`/${lang}/`)) return url;
    return `/${lang}${url}`;
  }
  // Relative path ("about", "projects/details", etc.) — prepend lang root
  return `/${lang}/${url.replace(/^\.?\//, "")}`;
}
---

{items.length > 0 && (
  <nav class={className} aria-label={slug}>
    <ul class="flex gap-4 items-center">
      {items.map((item) => {
        const translation = pickTranslation(item.translations, lang);
        const label = translation?.label ?? item.url;
        const href = resolveMenuUrl(item.url, lang);
        return (
          <li>
            <a class="font-regular uppercase" href={href} class="hover:underline">{label}</a>
          </li>
        );
      })}
    </ul>
  </nav>
)}
