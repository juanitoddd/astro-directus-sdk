---
import EditorJs from "@/components/directus/EditorJs.astro";
import { getDirectusAssetAlt, getDirectusAssetSrcset, getDirectusAssetUrl } from "@/lib/directus/assets";
import { pickTranslation, type Hero } from "@/lib/directus/types";
import { getDirectusEditAttr, type DirectusVisualEditable } from "@/lib/directus/visual-editor";

type Props = {
  hero: Hero;
  lang: string;
  eager?: boolean;
};

const { hero, lang, eager = true } = Astro.props as Props;
const translation = pickTranslation(hero.translations, lang);

const imageSrc = getDirectusAssetUrl(hero.background, { width: 1280, format: "webp", quality: 80 });
const imageSrcset = getDirectusAssetSrcset(hero.background, [640, 1280, 1920, 2560], { format: "webp", quality: 80 });
const imageAlt = getDirectusAssetAlt(hero.background);

const editable: DirectusVisualEditable = {
  __directus: {
    collection: "hero",
    item: hero.id,
    translationCollection: "hero_translations",
    translationItem: translation?.id ?? null,
  },
};
---

<section
  class="relative w-full min-h-[80vh] flex items-center justify-center text-white overflow-hidden"
  data-directus={getDirectusEditAttr(editable, "background", { translated: false })}
>
  {imageSrc && (
    <img
      src={imageSrc}
      srcset={imageSrcset}
      sizes="100vw"
      alt={imageAlt}
      class="absolute inset-0 w-full h-full object-cover"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
    />
  )}
  <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
  <div
    class="relative z-10 max-w-3xl text-center px-6 py-12"
    data-directus={getDirectusEditAttr(editable, "content")}
  >
    <EditorJs content={translation?.content} />
  </div>
</section>
