---
import Block from "@/components/directus/Block.astro";
import Grid from "@/components/directus/Grid.astro";
import Hero from "@/components/directus/Hero.astro";
import Slider from "@/components/directus/Slider.astro";
import type { PageSection } from "@/lib/directus/types";

type Props = {
  section: PageSection;
  lang: string;
};

const { section, lang } = Astro.props as Props;
---

{section.collection === "block" && <Block block={section.item} lang={lang} />}
{section.collection === "grid" && <Grid grid={section.item} lang={lang} />}
{section.collection === "hero" && <Hero hero={section.item} lang={lang} />}
{section.collection === "slider" && <Slider slider={section.item} lang={lang} />}
