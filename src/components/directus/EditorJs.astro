---
import BlockRenderer from "@/components/directus/BlockRenderer.astro";
import type { EditorJsBlock, EditorJsContent } from "@/lib/directus/types";

type Props = {
  content: EditorJsContent | null | undefined;
  class?: string;
};

const { content, class: className } = Astro.props as Props;
const blocks: EditorJsBlock[] = content?.blocks ?? [];
---

<div class={className}>
  {blocks.map((block) => <BlockRenderer block={block} />)}
</div>
