---
import EditorJs from "@/components/directus/EditorJs.astro";
import { pickTranslation, type Grid } from "@/lib/directus/types";
import { getDirectusEditAttr, type DirectusVisualEditable } from "@/lib/directus/visual-editor";

type Props = {
  grid: Grid;
  lang: string;
};

const { grid, lang } = Astro.props as Props;
const translation = pickTranslation(grid.translations, lang);

const editable: DirectusVisualEditable = {
  __directus: {
    collection: "grid",
    item: grid.id,
    translationCollection: "grid_translations",
    translationItem: translation?.id ?? null,
  },
};
---

<section class="container py-4 grid grid-cols-1 md:grid-cols-2 gap-6">
  <div data-directus={getDirectusEditAttr(editable, "content_left")}>
    <EditorJs content={translation?.content_left} />
  </div>
  <div data-directus={getDirectusEditAttr(editable, "content_right")}>
    <EditorJs content={translation?.content_right} />
  </div>
</section>
