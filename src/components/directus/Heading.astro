---
import { pickTranslation, type Heading } from "@/lib/directus/types";
import { getDirectusEditAttr, type DirectusVisualEditable } from "@/lib/directus/visual-editor";

type Props = {
  heading: Heading;
  lang: string;
};

const { heading, lang } = Astro.props as Props;
const translation = pickTranslation(heading.translations, lang);

const editable: DirectusVisualEditable = {
  __directus: {
    collection: "heading",
    item: heading.id,
    translationCollection: "heading_translations",
    translationItem: translation?.id ?? null,
  },
};
---

<section class="container heading-section py-4" data-directus={getDirectusEditAttr(editable, "content")}>
  {translation?.content && <div class="wysiwyg" set:html={translation.content} />}
</section>
