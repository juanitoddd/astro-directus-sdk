---
import Block from "@/components/directus/Block.astro";
import Hero from "@/components/directus/Hero.astro";
import News from "@/components/directus/News.astro";
import type { Slider } from "@/lib/directus/types";
import { getDirectusEditAttr, type DirectusVisualEditable } from "@/lib/directus/visual-editor";

type Props = {
  slider: Slider;
  lang: string;
};

const { slider, lang } = Astro.props as Props;
const slides = (slider.slides ?? []).slice().sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));
const sliderId = `slider-${slider.id}`;
const constrained = !slider.fullwidth;
const autoplay = !!slider.autoplay && slides.length > 1;

const editable: DirectusVisualEditable = {
  __directus: {
    collection: "slider",
    item: slider.id,
    translationCollection: "slider",
    translationItem: null,
  },
};
---

<section
  class:list={["slider relative py-4 overflow-x-clip", { container: constrained }]}
  data-slider-id={sliderId}
  data-slider-autoplay={autoplay ? "" : undefined}
  data-directus={getDirectusEditAttr(editable, ["slides", "fullwidth", "autoplay"], { translated: false })}
>
  <div
    id={sliderId}
    class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-4 -mx-4 px-4"
    style="scrollbar-width:none"
  >
    {slides.map((slide, idx) => (
      <div class="slide shrink-0 snap-center w-full">
        {slide.collection === "block" && <Block block={slide.item} lang={lang} />}
        {slide.collection === "hero" && <Hero hero={slide.item} lang={lang} eager={idx === 0} />}
        {slide.collection === "news" && <News news={slide.item} lang={lang} eager={idx === 0} />}
      </div>
    ))}
  </div>

  {slides.length > 1 && (
    <div class="flex justify-center gap-2 mt-3">
      <button
        type="button"
        class="px-3 py-1 border rounded"
        data-slider-prev={sliderId}
        aria-label="Previous slide"
      >‹</button>
      <button
        type="button"
        class="px-3 py-1 border rounded"
        data-slider-next={sliderId}
        aria-label="Next slide"
      >›</button>
    </div>
  )}
</section>

<script>
  const AUTOPLAY_INTERVAL = 4000;

  function step(id: string, direction: 1 | -1) {
    const el = document.getElementById(id);
    if (!el) return;
    const slide = el.querySelector<HTMLElement>(".slide");
    const delta = slide ? slide.offsetWidth + 16 : el.clientWidth;
    // Loop back to the start once we can't advance any further.
    if (direction === 1 && el.scrollLeft + el.clientWidth >= el.scrollWidth - 1) {
      el.scrollTo({ left: 0, behavior: "smooth" });
      return;
    }
    el.scrollBy({ left: delta * direction, behavior: "smooth" });
  }
  document.querySelectorAll<HTMLButtonElement>("[data-slider-prev]").forEach((btn) => {
    btn.addEventListener("click", () => step(btn.dataset.sliderPrev!, -1));
  });
  document.querySelectorAll<HTMLButtonElement>("[data-slider-next]").forEach((btn) => {
    btn.addEventListener("click", () => step(btn.dataset.sliderNext!, 1));
  });

  document.querySelectorAll<HTMLElement>("[data-slider-autoplay]").forEach((section) => {
    const id = section.dataset.sliderId;
    if (!id) return;
    let timer: ReturnType<typeof setInterval> | undefined;
    const start = () => {
      if (timer) return;
      timer = setInterval(() => step(id, 1), AUTOPLAY_INTERVAL);
    };
    const stop = () => {
      clearInterval(timer);
      timer = undefined;
    };
    // Pause while the visitor is interacting, resume when they leave.
    section.addEventListener("mouseenter", stop);
    section.addEventListener("mouseleave", start);
    section.addEventListener("focusin", stop);
    section.addEventListener("focusout", start);
    // Don't advance an off-screen slider.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        for (const entry of entries) entry.isIntersecting ? start() : stop();
      }).observe(section);
    } else {
      start();
    }
  });
</script>
