---
import { getDirectusAssetUrl, type DirectusAsset } from '@/lib/directus/assets';
import { fetchEventsUpcoming } from '@/lib/directus/events';
import { pickTranslation, type Slider } from "@/lib/directus/types";

type Props = {
  slider: Slider;
  lang: string;
};

const { lang } = Astro.props as Props;
const sliderId = `slider-concerts`;

const events = await fetchEventsUpcoming(lang);
// console.log("events~~>", events)
---

<section
  class:list={["slider relative py-4 overflow-x-clip", { container: true }]}
  data-slider-id={'concerts'}
  data-slider-autoplay  
>
  <div
    id={sliderId}
    class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-4 xl:-mx-4 xl:px-4"
    style="scrollbar-width:none"
  >
    {events.map((event, idx) => {
        const url = event.image?.id ? getDirectusAssetUrl(event.image.id as DirectusAsset) : null;
        let posX = '100%'
        let posY = '100%'
        if(url) {
          const height = event.image.height
          const width = event.image.width
          const focal_point_x = event.image.focal_point_x
          const focal_point_y = event.image.focal_point_y
          if(focal_point_x && focal_point_y) {
            const pos_x = focal_point_x / width
            const pos_y = focal_point_y / height
            posX = `${pos_x * 100}%`
            posY = `${pos_y * 100}%`
            console.log("event.image ~~>", height, width, focal_point_x, focal_point_y)
            console.log("position ~~>", posX, posY)
          }
        }
        const _event = pickTranslation(event.translations as unknown as any, lang ?? "") 
        const _location = pickTranslation(event.location_id.translations as unknown as any, lang ?? "")

        const pad = (value: string) => String(value).padStart(2, "0");
        const _date = new Date(event.date);

        const day = String(_date.getDate()).padStart(2, "0");
        const month = String(_date.getMonth() + 1).padStart(2, "0");
        const year = _date.getFullYear();
        const hours = String(_date.getHours());
        const minutes = String(_date.getMinutes());

        const date = `${pad(day)}.${pad(month)}.${year}`;
        const time = `${pad(hours)}:${pad(minutes)}`;
        return (
        <div class="slide shrink-0 snap-center w-full">
          <a href={`/${lang}/events/${event.id}`}>          
            <div class="md:grid block grid-cols-2">
              <div>
                <div class="mb-2">
                  <h1 class="md:text-5xl text-lg text-gmjo-blue font-bold">{date}</h1>
                  <h1 class="md:text-5xl text-lg font-thin text-black">{time}</h1>
                </div>
                <h3 class="text-black">{_event.title}</h3>
                <h4 class="text-black">{_location.city}, {_location.country}</h4>
              </div>
              <div>
                {url ? (
                  <div class="image-box overflow-hidden" style="height: 400px; width: 100%">
                    <img src={url} style={{"object-position": `${posX} ${posY}`}} class="object-cover w-full h-full block" />
                  </div>
                  ) : null}
              </div>
            </div>
          </a>
        </div>
        )
      }
    )}
  </div>

  {events.length > 1 && (
    <div class="flex justify-center gap-2 mt-3">
      <button
        type="button"
        class="px-3 py-1 border rounded"
        data-slider-prev={sliderId}
        aria-label="Previous slide"
      >‹</button>
      <button
        type="button"
        class="px-3 py-1 border rounded"
        data-slider-next={sliderId}
        aria-label="Next slide"
      >›</button>
    </div>
  )}
</section>

<script>
  const AUTOPLAY_INTERVAL = 4000;

  function step(id: string, direction: 1 | -1) {
    const el = document.getElementById(id);
    if (!el) return;
    const slide = el.querySelector<HTMLElement>(".slide");
    const delta = slide ? slide.offsetWidth + 16 : el.clientWidth;
    // Loop back to the start once we can't advance any further.
    if (direction === 1 && el.scrollLeft + el.clientWidth >= el.scrollWidth - 1) {
      el.scrollTo({ left: 0, behavior: "smooth" });
      return;
    }
    el.scrollBy({ left: delta * direction, behavior: "smooth" });
  }
  document.querySelectorAll<HTMLButtonElement>("[data-slider-prev]").forEach((btn) => {
    btn.addEventListener("click", () => step(btn.dataset.sliderPrev!, -1));
  });
  document.querySelectorAll<HTMLButtonElement>("[data-slider-next]").forEach((btn) => {
    btn.addEventListener("click", () => step(btn.dataset.sliderNext!, 1));
  });

  document.querySelectorAll<HTMLElement>("[data-slider-autoplay]").forEach((section) => {
    const id = section.dataset.sliderId;
    if (!id) return;
    let timer: ReturnType<typeof setInterval> | undefined;
    const start = () => {
      if (timer) return;
      timer = setInterval(() => step(id, 1), AUTOPLAY_INTERVAL);
    };
    const stop = () => {
      clearInterval(timer);
      timer = undefined;
    };
    // Pause while the visitor is interacting, resume when they leave.
    section.addEventListener("mouseenter", stop);
    section.addEventListener("mouseleave", start);
    section.addEventListener("focusin", stop);
    section.addEventListener("focusout", start);
    // Don't advance an off-screen slider.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        for (const entry of entries) entry.isIntersecting ? start() : stop();
      }).observe(section);
    } else {
      start();
    }
  });
</script>
