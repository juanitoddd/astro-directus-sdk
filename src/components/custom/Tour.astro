---
import { getDirectusAssetUrl, type DirectusAsset } from '@/lib/directus/assets';
import { fetchEventsByTour, aggregateInterpreters } from '@/lib/directus/events';
import { fetchTourById } from '@/lib/directus/tours';
import { pickTranslation } from '@/lib/directus/types';

// Example custom block. Copy this file and rename it; the block's `name` must match the
// filename exactly (e.g. `name: "Hello"` → Hello.astro).
//
// Every custom component receives:
//   - data:  the block's data object (read your own args from here, incl. `name`)
//   - lang:  the current language code
//   - depth: nesting depth (for recursion guards, if you render EditorJS content)
type Props = {
  data?: Record<string, unknown>;
  lang?: string;
  depth?: number;
  tourId?: number | string;
};

const { lang, tourId } = Astro.props as Props;
// const tourId = data.params?.tourId;
const events = (await fetchEventsByTour(tourId, lang) ?? []).sort(
  (a: any, b: any) => String(a.date ?? "").localeCompare(String(b.date ?? "")),
);
// const interprets = aggregateInterpreters(events)
const tour = await fetchTourById(tourId, lang);
// console.log("tour~~>", tour)

// ISO date ("2026-01-15T20:00:00") → "15.01.2026". Pure string work, no library needed.
const formatDate = (iso: string | null | undefined) => {
  const [y, m, d] = String(iso ?? "").split("T")[0].split("-");
  return d && m && y ? `${d}.${m}.${y}` : "";
};
// "…T20:00:00" → "20:00"
const formatTime = (iso: string | null | undefined) =>
  String(iso ?? "").split("T")[1]?.slice(0, 5) ?? "";
---

<div class="my-4 p-4 border-t border-black">
  <div class="grid grid-cols-2-3">
    <div>
      <div class="font-bold text-xl text-gmjo-blue">{tour?.translations[0]?.title ?? ''}</div>
    </div>
    <div>

      <details class="accordion border-b group">
        <summary class="flex items-center gap-2 cursor-pointer select-none py-3 font-bold list-none [&::-webkit-details-marker]:hidden">
          {/* Custom marker (native one is hidden) — rotates to point down when open. */}
          <svg
            class="w-3 h-3 shrink-0 transition-transform group-open:rotate-90"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <polyline points="9 6 15 12 9 18" />
          </svg>
          <span class="flex-1">
            <h2 class="text-gmjo-blue text-lg font-thin">{lang === 'en' ? 'Concerts' : 'Konzerte'}</h2>
          </span>
        </summary>
        <div class="pb-4">
          {(events ?? []).map((event: any) => {            
            const interpreters = event.interpreters;
            interpreters.map((interpreter: any) => {
              const person = interpreter.person_id;            
              const role = pickTranslation(interpreter.role_id.translations, lang);
              // console.log("role~~>", role.name, role.id)
            })
            const conductorID = 19; // Assuming 19 is the ID for the conductor role
            const conductor = interpreters.find((i: any) => i.role_id.id === conductorID);            
            const _event =  pickTranslation(event.translations, lang ?? "")            
            const role = conductor ? pickTranslation(conductor.role_id.translations, lang ?? "") : null;
            const location = pickTranslation(event.location_id?.translations, lang ?? "");            
            return (
              <div class="grid grid-cols-3 gap-2 py-2" style="grid-template-columns: 100px auto 200px;">
              <div>
                <div class="font-bold">{formatDate(event.date)}</div>
                <div>{formatTime(event.date)}</div>
              </div>
              <div>
                <div><a class="font-bold text-gmjo-blue underline-link" href={`/${lang}/events/${event.id}`}>{_event?.title ?? ''}</a></div>
                <div>{location?.name ?? ''}</div>
              </div>
              <div>
                {conductor && (
                  <div>{conductor.person_id.first_name} {conductor.person_id.last_name}, {role?.name ?? ''}</div>
                )}
              </div>
            </div>
            )
          }
        )}
        </div>
      </details>

      {/* Artists */}
      <details class="accordion border-b group">
        <summary class="flex items-center gap-2 cursor-pointer select-none py-3 font-bold list-none [&::-webkit-details-marker]:hidden">
          {/* Custom marker (native one is hidden) — rotates to point down when open. */}
          <svg
            class="w-3 h-3 shrink-0 transition-transform group-open:rotate-90"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <polyline points="9 6 15 12 9 18" />
          </svg>
          <span class="flex-1">
            <h2 class="text-gmjo-blue text-lg font-thin">{lang === 'en' ? 'Artists' : 'Künstler'}</h2>
          </span>
        </summary>
        <div class="pb-4 md:grid grid-cols-3 gap-4">
          {(tour?.artists ?? []).map((artist: any) => {            
            const person = artist.people_id;            
            const url = getDirectusAssetUrl(person.image as DirectusAsset);
            return(
              <div class="">
                <a class="underline-link text-gmjo-blue font-bold" href={`/${lang}/biography/${person.id}`}>
                  <img src={url} class="object-cover" style="width: 200px; height: 230px;" />
                  <div class="">{person.first_name} {person.last_name}</div>
                </a>
              </div>
            )
          })}
        </div>
      </details>

      {/* Tutors */}
      <details class="accordion border-b group">
        <summary class="flex items-center gap-2 cursor-pointer select-none py-3 font-bold list-none [&::-webkit-details-marker]:hidden">
          {/* Custom marker (native one is hidden) — rotates to point down when open. */}
          <svg
            class="w-3 h-3 shrink-0 transition-transform group-open:rotate-90"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <polyline points="9 6 15 12 9 18" />
          </svg>
          <span class="flex-1">
            <h2 class="text-gmjo-blue text-lg font-thin">{lang === 'en' ? 'Tutors' : 'Dozenten'}</h2>
          </span>
        </summary>
        <div class="pb-4 md:grid grid-cols-3 gap-4">
          {(tour?.tutors ?? []).map((artist: any) => {            
            const person = artist.people_id;            
            const url = getDirectusAssetUrl(person.image as DirectusAsset);
            return(
              <div class="">
                <a class="underline-link text-gmjo-blue font-bold" href={`/${lang}/biography/${person.id}`}>
                  <img src={url} class="object-cover" style="width: 200px; height: 230px;" />
                  <div class="">{person.first_name} {person.last_name}</div>
                </a>
              </div>
            )
          })}
        </div>
      </details>

      {/* Orchestra members */}
      <details class="accordion border-b group">
        <summary class="flex items-center gap-2 cursor-pointer select-none py-3 font-bold list-none [&::-webkit-details-marker]:hidden">
          {/* Custom marker (native one is hidden) — rotates to point down when open. */}
          <svg
            class="w-3 h-3 shrink-0 transition-transform group-open:rotate-90"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <polyline points="9 6 15 12 9 18" />
          </svg>
          <span class="flex-1">
            <h2 class="text-gmjo-blue text-lg font-thin">{lang === 'en' ? 'Orchestra members' : 'Orchestermitglieder'}</h2>
          </span>
        </summary>
        <div class="pb-4 md:grid grid-cols-3 gap-4">
          {(tour?.orchestra ?? []).map((artist: any) => {            
            const person = artist.people_id;            
            const url = getDirectusAssetUrl(person.image as DirectusAsset);
            return(
              <div class="">
                <a class="underline-link text-gmjo-blue font-bold" href={`/${lang}/biography/${person.id}`}>
                  <img src={url} class="object-cover" style="width: 200px; height: 230px;" />
                  <div class="">{person.first_name} {person.last_name}</div>
                </a>
              </div>
            )
          })}
        </div>
      </details>      
                      
    </div>
  </div>    
</div>
