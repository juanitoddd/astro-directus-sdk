---
import ToursWidget from "@/components/custom/ToursWidget.tsx";
import { fetchTourYears } from "@/lib/directus/tours";
import { directus_url } from "@/lib/directus/directusSDK";
import Tour from './Tour.astro';

type Props = {
  data?: Record<string, unknown>;
  lang?: string;
  depth?: number;
};

const { lang } = Astro.props as Props;

// Only the list of available years is fetched server-side (for the prev/next bounds).
// The actual tours are fetched client-side by the island — initial year on mount, then again
// on every year change — so we never pre-fetch every year.
const years = await fetchTourYears();
const initialYear = years.length ? years[years.length - 1] : 2025;
---

<Tour tourId="105" />

<h2 class="text-2xl font-bold text-gmjo-blue uppercase">{lang === 'en' ? 'Tour Archive' : 'Tournee Archiv'}</h2>

<ToursWidget
  client:load
  lang={lang}
  years={years}
  initialYear={initialYear}
  directusUrl={directus_url}
/>
