---
import Layout from "@/layouts/Layout.astro";
import SectionRenderer from "@/components/directus/SectionRenderer.astro";
import { fetchAllPageSlugs, fetchPageBySlug } from "@/lib/directus/page";
import { languagePrefixes } from "@/constants/languages";
import type { Page } from "@/lib/directus/types";

export async function getStaticPaths() {
  const slugs = await fetchAllPageSlugs();
  const pages = await Promise.all(
    slugs.map(async (slug) => {
      const page = await fetchPageBySlug(slug);
      return page ? { slug, page } : null;
    }),
  );
  const valid = pages.filter((p): p is { slug: string; page: Page } => p !== null);

  return languagePrefixes.flatMap((lang) =>
    valid.map(({ slug, page }) => ({
      params: { lang, slug },
      props: { page },
    })),
  );
}

type Props = { page: Page };
const { page } = Astro.props as Props;
const lang = Astro.params.lang as string;
const sections = page.sections ?? [];
---

<Layout>
  {sections.map((section) => <SectionRenderer section={section} lang={lang} />)}
</Layout>
