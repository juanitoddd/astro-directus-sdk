---
import Layout from "@/layouts/Layout.astro";
import EditorJs from "@/components/directus/EditorJs.astro";
import SectionRenderer from "@/components/directus/SectionRenderer.astro";
import { fetchAllNewsSlugs, fetchNewsBySlug } from "@/lib/directus/news";
import { getDirectusAssetAlt, getDirectusAssetUrl } from "@/lib/directus/assets";
import { pickTranslation, type News } from "@/lib/directus/types";
import { languagePrefixes } from "@/constants/languages";

export async function getStaticPaths() {
  const slugs = await fetchAllNewsSlugs();
  const items = await Promise.all(
    slugs.map(async (slug) => {
      const news = await fetchNewsBySlug(slug);
      return news ? { slug, news } : null;
    }),
  );  
  const valid = items.filter((i): i is { slug: string; news: News } => i !== null);

  return languagePrefixes.flatMap((lang) =>
    valid.map(({ slug, news }) => ({
      params: { lang, slug },
      props: { news },
    })),
  );
}

const { lang, slug } = Astro.params;
const news = await fetchNewsBySlug(slug);
const sections = news?.sections ?? [];
const imageSrc = getDirectusAssetUrl(news?.image, { width: 1280, format: "webp", quality: 80 });
const imageAlt = getDirectusAssetAlt(news?.image);

// Focal point → object-position (%). Pixel coords → percentage of the intrinsic width/height,
// falling back to center. Only visible when the image is cropped (object-cover + fixed aspect).
type FocalImage = {
  focal_point_x?: number | null;
  focal_point_y?: number | null;
  width?: number | null;
  height?: number | null;
};
const focal = news?.image as FocalImage | undefined;

const newsTranslation = pickTranslation(news?.translations, lang as string);
/*
function opPct(coord?: number | null, size?: number | null): string | null {
  return coord != null && size ? `${Math.round((coord / size) * 10000) / 100}%` : null;
}
const opX = opPct(focal?.focal_point_x, focal?.width);
const opY = opPct(focal?.focal_point_y, focal?.height);
const objectPosition = opX || opY ? `object-position:${opX ?? "50%"} ${opY ?? "50%"}` : undefined;
*/
const objectPosition = {}
---

<Layout>
  <article class="container py-8">
    {newsTranslation?.title && <div class="mb-8"><h1 class="text-3xl font-bold mb-4">{newsTranslation.title}</h1></div>}
    {imageSrc && (
      <img src={imageSrc} alt={imageAlt} class="news-image object-cover w-full aspect-video mb-6" style={objectPosition} loading="eager" />
    )}    
    {sections.map((section) => <SectionRenderer section={section} lang={lang as string} />)}
  </article>
</Layout>
