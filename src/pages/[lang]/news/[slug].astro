---
import Layout from "@/layouts/Layout.astro";
import EditorJs from "@/components/directus/EditorJs.astro";
import SectionRenderer from "@/components/directus/SectionRenderer.astro";
import { fetchAllNewsSlugs, fetchNewsBySlug } from "@/lib/directus/news";
import { getDirectusAssetAlt, getDirectusAssetUrl } from "@/lib/directus/assets";
import { pickTranslation, type News } from "@/lib/directus/types";
import { languagePrefixes } from "@/constants/languages";

export async function getStaticPaths() {
  const slugs = await fetchAllNewsSlugs();
  const items = await Promise.all(
    slugs.map(async (slug) => {
      const news = await fetchNewsBySlug(slug);
      return news ? { slug, news } : null;
    }),
  );
  console.log("items", items);
  const valid = items.filter((i): i is { slug: string; news: News } => i !== null);

  return languagePrefixes.flatMap((lang) =>
    valid.map(({ slug, news }) => ({
      params: { lang, slug },
      props: { news },
    })),
  );
}

const { lang, slug } = Astro.params;
const news = await fetchNewsBySlug(slug);
const sections = news?.sections ?? [];
const imageSrc = getDirectusAssetUrl(news?.image, { width: 1280, format: "webp", quality: 80 });
const imageAlt = getDirectusAssetAlt(news?.image);
---

<Layout>
  <article class="container py-8">
    {news?.name && <div class="mb-8"><h1 class="text-3xl font-bold mb-4">{news?.name}</h1></div>}
    {imageSrc && (
      <img src={imageSrc} alt={imageAlt} class="news-image object-cover w-full h-auto mb-6" loading="eager" />
    )}    
    {sections.map((section) => <SectionRenderer section={section} lang={lang as string} />)}
  </article>
</Layout>
