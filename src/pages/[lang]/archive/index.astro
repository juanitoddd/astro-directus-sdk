---
import Layout from "@/layouts/Layout.astro";
import { languagePrefixes } from "@/constants/languages";
import { fetchAllTourYears } from "@/lib/directus/tours";

export const prerender = true;

export function getStaticPaths() {
  return languagePrefixes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? "en";
const years = await fetchAllTourYears();
---

<Layout>
  <section class="container py-8" data-archive data-lang={lang}>
    <h1>Tour Archive</h1>
    <div class="md:grid block gap-4" style="grid-template-columns: 40% 60%;">
      <div class="pr-4">
        <form class="my-8" data-archive-form>
          <div class="grid my-2" style="grid-template-columns: 35% 65%;">
            <label for="archive-year">Year</label>
            <select id="archive-year" class="border border-gray-300 rounded-md py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500" name="year">
              <option value="">-</option>
              {years.map((year) => <option value={year}>{year}</option>)}
            </select>
          </div>
          <div class="grid my-2" style="grid-template-columns: 35% 65%;">
            <label for="archive-tour">Tour name</label>
            <input id="archive-tour" class="border border-gray-300 rounded-md py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500" type="search" name="tour" />
          </div>
          <div class="grid my-2" style="grid-template-columns: 35% 65%;">
            <label for="archive-author">Author</label>
            <input id="archive-author" class="border border-gray-300 rounded-md py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500" type="search" name="author" />
          </div>
          <div class="grid my-2" style="grid-template-columns: 35% 65%;">
            <label for="archive-interpreter">Interpreter</label>
            <input id="archive-interpreter" class="border border-gray-300 rounded-md py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500" type="search" name="interpreter" />
          </div>
          <div class="grid my-2" style="grid-template-columns: 35% 65%;">
            <label for="archive-repertoire">Repertoire</label>
            <input id="archive-repertoire" class="border border-gray-300 rounded-md py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500" type="search" name="repertoire" />
          </div>
          <div class="grid my-2" style="grid-template-columns: 35% 65%;">
            <label for="archive-location">Location</label>
            <input id="archive-location" class="border border-gray-300 rounded-md py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500" type="search" name="location" />
          </div>
          <div class="mt-3 flex gap-2">
            <button type="submit" class="md:col-span-3 p-2 bg-blue-500 text-white rounded">Search</button>
            <button type="reset" class="p-2 border border-gray-300 rounded">Reset</button>
          </div>
        </form>
      </div>
      <div class="pt-4" aria-live="polite" aria-busy="false" data-archive-output>
        <p data-archive-status hidden></p>
        <div class="grid gap-8" data-archive-results></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  type ArchiveResult = {
    id: string | number;
    title: string;
    date: string;
    city: string;
    country: string;
  };

  const root = document.querySelector<HTMLElement>("[data-archive]");
  const form = root?.querySelector<HTMLFormElement>("[data-archive-form]");
  const output = root?.querySelector<HTMLElement>("[data-archive-output]");
  const status = root?.querySelector<HTMLElement>("[data-archive-status]");
  const resultList = root?.querySelector<HTMLElement>("[data-archive-results]");

  function setStatus(message: string) {
    if (!status) return;
    status.textContent = message;
    status.hidden = !message;
  }

  function renderResults(results: ArchiveResult[], language: string) {
    if (!resultList) return;
    resultList.replaceChildren();
    for (const event of results) {
      const wrapper = document.createElement("div");
      wrapper.className = "border-b border-solid border-gmjo-blue";
      const link = document.createElement("a");
      link.href = `/${encodeURIComponent(language)}/events/${encodeURIComponent(String(event.id))}`;
      link.target = "_blank";
      link.rel = "noopener";

      const headingRow = document.createElement("div");
      headingRow.className = "flex items-center justify-between";
      const title = document.createElement("h2");
      title.className = "md:text-3xl text-lg text-gmjo-blue font-bold";
      title.textContent = event.title;
      const place = document.createElement("h4");
      place.className = "text-black text-right";
      place.textContent = [event.city, event.country].filter(Boolean).join(", ");
      headingRow.append(title, place);

      const dateRow = document.createElement("div");
      dateRow.className = "flex gap-2 mt-2";
      const date = document.createElement("div");
      date.className = "text-lg text-gmjo-blue font-bold";
      const [year, month, day] = event.date.split("T")[0].split("-");
      date.textContent = day && month && year ? `${day}.${month}.${year}` : "";
      const time = document.createElement("div");
      time.className = "text-lg font-thin text-black";
      time.textContent = event.date.includes("T") ? event.date.split("T")[1].slice(0, 5) : "";
      dateRow.append(date, document.createTextNode(" - "), time);
      link.append(headingRow, dateRow);
      wrapper.append(link);
      resultList.append(wrapper);
    }
  }

  async function search(updateHistory = true) {
    if (!root || !form || !output) return;
    const params = new URLSearchParams();
    for (const [name, value] of new FormData(form)) {
      const normalized = String(value).trim();
      if (normalized) params.set(name, normalized);
    }
    if (updateHistory) {
      const query = params.toString();
      history.pushState({}, "", `${location.pathname}${query ? `?${query}` : ""}`);
    }
    renderResults([], root.dataset.lang ?? "en");
    if (!params.size) {
      setStatus("");
      return;
    }

    output.setAttribute("aria-busy", "true");
    setStatus("Searching…");
    params.set("lang", root.dataset.lang ?? "en");
    try {
      const response = await fetch(`/api/archive.json?${params}`);
      if (!response.ok) throw new Error(`Archive request failed: ${response.status}`);
      const data = await response.json() as { results: ArchiveResult[] };
      renderResults(data.results, root.dataset.lang ?? "en");
      setStatus(data.results.length ? "" : "No archive entries found.");
    } catch (error) {
      console.error("[archive] search failed", error);
      renderResults([], root.dataset.lang ?? "en");
      setStatus("The archive could not be searched.");
    } finally {
      output.setAttribute("aria-busy", "false");
    }
  }

  function loadUrlState() {
    if (!form) return;
    const params = new URLSearchParams(location.search);
    for (const element of form.elements) {
      if ((element instanceof HTMLInputElement || element instanceof HTMLSelectElement) && element.name) {
        element.value = params.get(element.name) ?? "";
      }
    }
    void search(false);
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    void search();
  });
  form?.addEventListener("reset", () => requestAnimationFrame(() => void search()));
  window.addEventListener("popstate", loadUrlState);
  loadUrlState();
</script>
