---
import Layout from "@/layouts/Layout.astro";
import { fetchAllEventIds, fetchEventById } from "@/lib/directus/events";
import { fetchLastDate } from "@/lib/directus/deployments";
import { languagePrefixes } from "@/constants/languages";
import { pickTranslation } from '@/lib/directus/types/translation';

export async function getStaticPaths() {
  // Only prebuild events changed since the last deployment (null → first build, prebuild all).
  const lastDeploy = await fetchLastDate();
  const ids = await fetchAllEventIds(lastDeploy);
  return languagePrefixes.flatMap((lang) =>
    ids.map((id) => ({ params: { lang, id: String(id) } })),
  );
}

const lang = Astro.params.lang as string;
const id = Astro.params.id as string;
const event = await fetchEventById(id, lang);
const hour = (event.date as string).split('T')[1].slice(0, -3);
// console.log("event~~>", event.repertoires)
// ISO date ("2026-01-15T20:00:00") → "15.01.2026". Pure string work, no library needed.
const formatDate = (iso: string | null | undefined) => {
  const [y, m, d] = String(iso ?? "").split("T")[0].split("-");
  return d && m && y ? `${d}.${m}.${y}` : "";
};

const location = pickTranslation(event.location_id?.translations, lang ?? "");
---

<Layout>
  <section class="container py-8">
    {event ? (
      <>
      <div class="md:grid grid-cols-2 gap-4 my-4" style="grid-template-columns: 1fr 70px;">
        <div>
          <h1 class="text-5xl font-bold text-gmjo-blue" style="font-size: 4rem;">{formatDate(event.date)}</h1>
          <h1 class="text-5xl font-thin" style="font-size: 4rem;">{hour}</h1>          
          {/*  
            <div><a href={event.location_id.url} target="_blank" rel="noopener noreferrer" class="uppercase underline-link font-bold">{event.organizer}</a></div>          
          */}
          <div class="uppercase underline-link font-bold">{event.organizer}</div>          
        </div>        
        <div class="flex items-end uppercase text-2xl font-thin">
          <a class="underline-link" href={event.link_to_ticketsite} target="_blank" rel="noopener noreferrer">
            {lang === 'de' ? 'Karten' : 'Tickets'}
          </a>
        </div>

      </div>
      <hr class="my-4"/>
      <div class="md:grid grid-cols-2 py-4">
        <div class="uppercase text-gmjo-blue font-bold text-lg mb-4 md:mb-0">{lang === 'de' ? 'Interpreten' : 'Interpreters'}</div>
        <div>
          {(event.interpreters ?? []).map((interpreter: any) => {
            const person = interpreter.person_id;            
            const role = pickTranslation(interpreter.role_id.translations, lang);            
            return(
              <div class="">                
                <a class="underline-link" href={`/${lang}/biography/${person.id}`}>
                  <div class=""><span class="text-gmjo-blue font-bold">{person.first_name} {person.last_name}</span> <span class="font-thin">{![88, 87].includes(role.id) ? `- ${role?.name ?? ''}` : null}</span></div>
                </a>
              </div>
            )
          })}
        </div>
      </div>
      <hr/>
      <div class="md:grid grid-cols-2 py-4">
        <div class="uppercase text-gmjo-blue font-bold text-lg mb-4 md:mb-0">{lang === 'de' ? 'Programm' : 'Programme'}</div>
        <div>
          {(event.repertoires ?? []).map((repertoire: any) => {            
            const title = pickTranslation(repertoire.repertoires_id.translations, lang)?.title || repertoire.repertoires_id.title;            
            const author = repertoire.repertoires_id.person_id;            
            return (              
              <div class="">              
                <span><a href={`/${lang}/biography/${author?.id}`} class="underline-link font-bold text-gmjo-blue">{author?.first_name} {author?.last_name}</a></span> <span>{title}</span>
              </div>          
            ) 
          })}
        </div>
      </div>
      <hr/>
      <div class="md:grid grid-cols-2 py-4">
        <div class="uppercase text-gmjo-blue font-bold text-lg mb-4 md:mb-0">{lang === 'de' ? 'Ort' : 'Place'}</div>
        <div>
          <div class="text-gmjo-blue font-bold underline-link"><a href={location.url} target="_blank" rel="noopener noreferrer">{location.name}</a></div>
          <div>{location.city} / {location.country}</div>
          <div>{location.postal_code} {location.address}</div>
        </div>
      </div>
      {/*
      <div class="py-4">
        <div class="uppercase text-gmjo-blue font-bold text-4xl">{lang === 'de' ? 'Kommende Veranstaltungen' : 'Upcoming events'}</div>
      </div>      
      */}
      </>
    ) : (
      <p>Event not found.</p>
    )}
  </section>
</Layout>
